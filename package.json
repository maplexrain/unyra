{
  "name": "unyra",
  "private": true,
  "version": "0.4.10",
  "description": "归一 Unyra · 探索式学习：本地优先的 AI 学习辅助桌面应用",
  "author": "maplexrain",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "electron:dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc -b",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run",
    "test:agent": "node scripts/run-agent-ops-test.mjs",
    "test:update": "node scripts/run-update-test.mjs",
    "start:trace": "node scripts/startup-trace.mjs",
    "lint": "oxlint",
    "start": "electron .",
    "release:win": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "release:verify": "node scripts/verify-release.mjs",
    "serve:updates": "node scripts/serve-updates.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fugood/node-whisper-wasm": "1.1.3",
    "@shikijs/langs": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "animejs": "^4.5.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "function-plot": "^1.25.4",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
