{
  "name": "unyra",
  "private": true,
  "version": "0.5.8",
  "description": "归一 Unyra · 探索式学习：本地优先的 AI 学习辅助桌面应用",
  "author": "maplexrain",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "electron:dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc -b",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:agent": "node scripts/run-agent-ops-test.mjs",
    "test:update": "node scripts/run-update-test.mjs",
    "start:trace": "node scripts/startup-trace.mjs",
    "lint": "oxlint",
    "start": "electron .",
    "release:win": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "release:verify": "node scripts/verify-release.mjs",
    "serve:updates": "node scripts/serve-updates.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/streamparser": "^6.0.0",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@shikijs/langs": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "animejs": "^4.5.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "function-plot": "^1.25.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "marked-katex-extension": "^5.1.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "tailwindcss": "^4.3.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
